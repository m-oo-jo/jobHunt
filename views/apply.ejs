<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>

    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <div class="container">
      <div class="job-card">
        <h1>Apply for Job</h1>
        <form action="/apply" method="POST">
          <table>
            <tr>
              <td><label>Full Name:</label></td>
              <td><input type="text" name="fullName" /></td>
            </tr>

            <tr>
              <td><label>Email:</label></td>
              <td><input type="email" name="email" /></td>
            </tr>

            <tr>
              <td><label>Phone Number:</label></td>
              <td><input type="tel" name="phone" /></td>
            </tr>

            <tr>
              <td><label>Experience:</label></td>
              <td>
                <select name="experience">
                  <option value="">Select experience</option>
                  <option value="Fresher">Fresher</option>
                  <option value="1-2 years">1-2 years</option>
                  <option value="3-5 years">3-5 years</option>
                  <option value="5+ years">5+ years</option>
                </select>
              </td>
            </tr>

            <tr>
              <td><label>Portfolio URL:</label></td>
              <td><input type="url" name="portfolio" /></td>
            </tr>

            <tr>
              <td><label>Cover Message:</label></td>
              <td><textarea name="message"></textarea></td>
            </tr>
            <tr>
              <td><button type="submit">Submit Application</button></td>
              <td><a href="/" class="apply-btn">Back to Home</a></td>
            </tr>
          </table>
        </form>

        <script>
                const form = document.querySelector("form");

                form.addEventListener("submit", function (event) {
                  const fullName = document.querySelector(
                    'input[name="fullName"]',
                  ).value;
                  const email = document.querySelector('input[name="email"]').value;
                  const phone = document.querySelector('input[name="phone"]').value;
                   const experience = document.querySelector('select[name="experience"]').value;

                  if (experience === "") {
                           event.preventDefault();
                           alert("Please select your experience.");
                  }

                  if (
                    fullName.trim() === "" ||email.trim() === "" ||phone.trim() === "") {
                    event.preventDefault();
                    alert("Please fill in all required fields.");
                  }

               const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

                  if (!emailPattern.test(email)) {
                    event.preventDefault();
                    alert("Please enter a valid email address.");
                  }

                  const phonePattern = /^[0-9]{10}$/;

                  if (!phonePattern.test(phone)) {
                    event.preventDefault();
                    alert("Please enter a valid 10-digit phone number.");
                  }




                });
        </script>
      </div>
    </div>
  </body>
</html>
