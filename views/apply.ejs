<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Apply for Job</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Google Font -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <%- include("partials/header") %>
    <main id="app-content" class="form-box py-5">
      <div class="job-card mx-auto">
        <h1 class="text-center mb-4">Apply for Job</h1>

        <form action="/apply" method="POST">
          <!-- Full Name -->
          <div class="mb-3">
            <label for="fullName" class="form-label">Full Name</label>

            <input
              type="text"
              id="fullName"
              name="fullName"
              class="form-control"
              placeholder="Enter your full name"
            />
            <div id="fullNameError"></div>
          </div>

          <!-- Email -->
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>

            <input
              type="email"
              id="email"
              name="email"
              class="form-control"
              placeholder="Enter your email"
            />
            <div id="emailError"></div>
          </div>

          <!-- Phone -->
          <div class="mb-3">
            <label for="phone" class="form-label">Phone Number</label>

            <input
              type="tel"
              id="phone"
              name="phone"
              class="form-control"
              placeholder="Enter your phone number"
            />
            <div id="phoneError"></div>
          </div>

          <!-- Experience -->
          <div class="mb-3">
            <label for="experience" class="form-label">Experience</label>

            <select name="experience" id="experience" class="form-select">
              <option value="">Select experience</option>
              <option value="Fresher">Fresher</option>
              <option value="1-2 years">1-2 years</option>
              <option value="3-5 years">3-5 years</option>
              <option value="5+ years">5+ years</option>
            </select>
            <div id="experienceError"></div>
          </div>

          <!-- Portfolio -->
          <div class="mb-3">
            <label for="portfolio" class="form-label">Portfolio URL</label>

            <input
              type="url"
              id="portfolio"
              name="portfolio"
              class="form-control"
              placeholder="https://example.com"
            />
            <div id="portfolioError"></div>
          </div>

          <!-- Cover Message -->
          <div class="mb-4">
            <label for="message" class="form-label">Cover Message</label>

            <textarea
              name="message"
              id="message"
              class="form-control"
              rows="5"
              placeholder="Write your cover message"
            ></textarea>
            <div id="messageCount"></div>
            <div id="messageError"></div>
          </div>

          <!-- Buttons -->
          <div class="d-grid gap-2 d-md-flex justify-content-md-center">
            <button type="submit" class="btn btn-primary">
              Submit Application
            </button>

            <a href="/" class="btn btn-secondary"> Back to Home </a>
          </div>
        </form>
      </div>
    </main>

  
   
    <%- include("partials/footer") %>
  </body>
</html>
