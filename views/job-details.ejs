<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= job.title %> - JobHunt</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/header") %>

    <main id="app-content" class="container py-5">

        <div class="job-card">

            <h1><%= job.title %></h1>

            <h4 class="job-company">
                <%= job.company %>
            </h4>

            <p>📍 <%= job.location %></p>
            <p>💼 <%= job.type %></p>
            <p>🏷️ <%= job.category %></p>

            <hr>

            <h3>About the Job</h3>

            <p>
                <%= job.description %>
            </p>

            <h3>Responsibilities</h3>

            <ul>
                <% job.responsibilities.forEach((item) => { %>
                    <li><%= item %></li>
                <% }) %>
            </ul>

            <h3>Requirements</h3>

            <ul>
                <% job.requirements.forEach((item) => { %>
                    <li><%= item %></li>
                <% }) %>
            </ul>

            <h3>Experience</h3>

            <p>
                <%= job.experience %>
            </p>

            <hr>

            <a href="/apply" class="apply-btn">
                Apply Now
            </a>

        </div>

    </main>

    <%- include("partials/footer") %>

</body>
</html>