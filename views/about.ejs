<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>About - JobHunt</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<%- include("partials/header") %>

<!-- About page -->

<main class="about-page">

  <!-- Hero section -->

  <section class="about-hero">

    <!-- Decorative background glow -->
    <div class="about-glow about-glow-one"></div>
    <div class="about-glow about-glow-two"></div>

    <div class="about-hero-content">

      <!-- Small section label -->
      <span class="about-badge">✦ ABOUT JOBHUNT</span>

      <!-- Main heading -->
      <h1>
        Where Talent Meets
        <span>Opportunity.</span>
      </h1>

      <!-- Short introduction -->
      <p>
        JobHunt connects talented people with companies
        looking for their next great hire.
      </p>

      <!-- Main CTA -->
      <a href="/jobs" class="about-primary-btn">
        Explore Jobs <span>→</span>
      </a>

    </div>

    <!-- Decorative job opportunity visual -->
    <div class="about-visual">

      <div class="about-floating-card">

        <div class="about-card-icon">💼</div>

        <div class="about-card-content">
          <strong>New Opportunity</strong>
          <small>Build your future</small>
        </div>

        <span class="about-check">✓</span>

      </div>

      <!-- Decorative orbit -->
      <div class="about-orbit"></div>

    </div>

  </section>

  <!-- Mission section -->

  <section class="about-mission">

    <div class="about-section-label">
      OUR MISSION
    </div>

    <h2>
      Making the journey from
      <span>search to opportunity</span>
      simpler.
    </h2>

    <p>
      JobHunt is designed to make discovering and applying
      for opportunities easier while giving recruiters a
      simple way to connect with potential candidates.
    </p>

  </section>

  <!-- Jobseeker and recruiter section -->

  <section class="about-audience">

    <!-- Jobseeker card -->
    <div class="about-audience-card">

      <div class="about-audience-icon">
        👨‍💻
      </div>

      <span class="about-card-label">
        FOR JOBSEEKERS
      </span>

      <h3>
        Find opportunities that fit you.
      </h3>

      <p>
        Explore available jobs, discover new opportunities
        and submit applications through a straightforward
        experience.
      </p>

      <a href="/jobs">
        Find a Job <span>→</span>
      </a>

    </div>

    <!-- Recruiter card -->
    <div class="about-audience-card recruiter-card">

      <div class="about-audience-icon">
        🏢
      </div>

      <span class="about-card-label">
        FOR RECRUITERS
      </span>

      <h3>
        Connect with the right talent.
      </h3>

      <p>
        Post job opportunities, manage your listings and
        receive applications from potential candidates.
      </p>

      <a href="/register">
        Start Hiring <span>→</span>
      </a>

    </div>

  </section>

  <!-- Final call-to-action -->

  <section class="about-cta">

    <div class="about-cta-glow"></div>

    <div class="about-cta-content">

      <span>
        YOUR NEXT OPPORTUNITY STARTS HERE
      </span>

      <h2>
        Ready to find what's next?
      </h2>

      <p>
        Explore opportunities and take the next step
        in your career.
      </p>

      <a href="/jobs" class="about-primary-btn">
        Browse Jobs <span>→</span>
      </a>

    </div>

  </section>

</main>

<%- include("partials/footer") %>

</body>

</html>
