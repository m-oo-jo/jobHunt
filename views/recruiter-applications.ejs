<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Applications - JobHunt</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/recruiter-header") %>

    <main class="container py-5">

        <!-- Page Header -->
        <div class="job-card mb-4">

            <h1 class="mb-2">
                Applications
            </h1>

            <p class="mb-0">
                View applications submitted for your job postings.
            </p>

        </div>


        <!-- Application Statistics -->
        <div class="row g-4 mb-5">

            <div class="col-md-4">

                <div class="job-card h-100">

                    <h2 id="totalApplications" class="mb-2">
                        0
                    </h2>

                    <p class="mb-0">
                        Total Applications
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="job-card h-100">

                    <h2 id="jobCount" class="mb-2">
                        0
                    </h2>

                    <p class="mb-0">
                        Jobs With Applications
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="job-card h-100">

                    <h2 id="latestApplication" class="mb-2">
                        -
                    </h2>

                    <p class="mb-0">
                        Latest Applicant
                    </p>

                </div>

            </div>

        </div>


        <!-- Applications -->
        <div class="job-card">

            <div class="mb-4">

                <h2 class="mb-2">
                    Received Applications
                </h2>

                <p class="mb-0">
                    Applications submitted by job seekers.
                </p>

            </div>


            <div id="applicationsList">

                <p>
                    Loading applications...
                </p>

            </div>

        </div>

    </main>


    <%- include("partials/footer") %>


    <script>

        fetch("/api/recruiter/applications")

            .then((response) => {

                if (!response.ok) {
                    throw new Error("Failed to fetch applications");
                }

                return response.json();

            })

            .then((applications) => {

                const applicationsList =
                    document.getElementById("applicationsList");

                const totalApplications =
                    document.getElementById("totalApplications");

                const jobCount =
                    document.getElementById("jobCount");

                const latestApplication =
                    document.getElementById("latestApplication");


                totalApplications.textContent =
                    applications.length;


                applicationsList.innerHTML = "";


                if (applications.length === 0) {

                    applicationsList.innerHTML = `
                        <p>
                            No applications received yet.
                        </p>
                    `;

                    return;
                }


                // Count unique jobs
                const uniqueJobs = new Set(
                    applications
                        .filter((application) => application.job)
                        .map((application) => application.job._id)
                );

                jobCount.textContent = uniqueJobs.size;


                // Latest applicant
                latestApplication.textContent =
                    applications[0].name || "-";


                applications.forEach((application) => {

                    const applicationCard =
                        document.createElement("div");

                    applicationCard.className =
                        "job-list-card mb-4";


                    const jobTitle =
                        application.job
                            ? application.job.title
                            : "Job information unavailable";


                    const company =
                        application.job
                            ? application.job.company
                            : "";


                    const appliedDate =
                        application.createdAt
                            ? new Date(
                                application.createdAt
                            ).toLocaleDateString()
                            : "-";


                    applicationCard.innerHTML = `

                        <div class="mb-3">

                            <h4>
                                ${jobTitle}
                            </h4>

                            <p class="job-company mb-1">
                                ${company}
                            </p>

                            <small>
                                Applied on ${appliedDate}
                            </small>

                        </div>


                        <hr>


                        <div class="mb-3">

                            <h5>
                                Applicant Details
                            </h5>

                            <p class="mb-1">
                                <strong>Name:</strong>
                                ${application.name || "-"}
                            </p>

                            <p class="mb-1">
                                <strong>Email:</strong>
                                ${application.email || "-"}
                            </p>

                            <p class="mb-1">
                                <strong>Phone:</strong>
                                ${application.phone || "-"}
                            </p>

                            <p class="mb-1">
                                <strong>Experience:</strong>
                                ${application.experience || "-"}
                            </p>

                        </div>


                        <div class="mb-3">

                            <h5>
                                Portfolio
                            </h5>

                            ${
                                application.portfolio
                                    ? `
                                        <a
                                            href="${application.portfolio}"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            View Portfolio
                                        </a>
                                    `
                                    : `
                                        <p class="mb-0">
                                            No portfolio provided.
                                        </p>
                                    `
                            }

                        </div>


                        <div>

                            <h5>
                                Message
                            </h5>

                            <p class="mb-0">
                                ${
                                    application.message
                                    || "No message provided."
                                }
                            </p>

                        </div>

                    `;


                    applicationsList.appendChild(
                        applicationCard
                    );

                });

            })

            .catch((error) => {

                console.error(
                    "Error loading applications:",
                    error
                );

                document.getElementById(
                    "applicationsList"
                ).innerHTML = `
                    <p>
                        Unable to load applications.
                        Please try again later.
                    </p>
                `;

            });

    </script>

</body>

</html>