<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Jobs - JobHunt</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Header -->
    <%- include("partials/header") %>


    <!-- Jobs Section -->
    <main id="app-content" class="container py-5">

        <div class="row g-4">

            <!-- Filters -->
            <div class="col-12 col-lg-3">

                <div class="job-card">

                    <h4 class="mb-4">Filters</h4>

                    <!-- Search -->
                    <div class="mb-3">

                        <label for="search" class="form-label">
                            Search Jobs
                        </label>

                        <input
                            type="text"
                            id="search"
                            class="form-control"
                            placeholder="Search by title..."
                        >

                    </div>


                    <!-- Category -->
                    <div class="mb-3">

                        <label for="category" class="form-label">
                            Category
                        </label>

                        <select id="category" class="form-select">

                            <option>All Categories</option>
                            <option>Development</option>
                            <option>Design</option>
                            <option>Marketing</option>

                        </select>

                    </div>


                    <!-- Location -->
                    <div class="mb-3">

                        <label for="location" class="form-label">
                            Location
                        </label>

                        <select id="location" class="form-select">

                            <option>All Locations</option>
                            <option>Remote</option>
                            <option>Bangalore</option>
                            <option>Hyderabad</option>

                        </select>

                    </div>


                    <!-- Job Type -->
                    <div class="mb-3">

                        <label class="form-label">
                            Job Type
                        </label>

                        <div class="form-check">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="fullTime"
                            >

                            <label
                                class="form-check-label"
                                for="fullTime"
                            >
                                Full Time
                            </label>

                        </div>


                        <div class="form-check">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="partTime"
                            >

                            <label
                                class="form-check-label"
                                for="partTime"
                            >
                                Part Time
                            </label>

                        </div>


                        <div class="form-check">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="remote"
                            >

                            <label
                                class="form-check-label"
                                for="remote"
                            >
                                Remote
                            </label>

                        </div>

                    </div>


                    <button class="btn-glow w-100">
                        Reset Filters
                    </button>

                </div>

            </div>


            <!-- Jobs -->
            <div class="col-12 col-lg-9">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>
                        <h2>All Jobs</h2>

                        <p class="text-muted mb-0">
                            Showing available opportunities
                        </p>
                    </div>

                    <select class="form-select w-auto">

                        <option>Sort by: Newest</option>
                        <option>Sort by: Oldest</option>

                    </select>

                </div>


                <!-- Job 1 -->
                <div class="job-list-card mb-3">

                    <div>

                        <h4>Software Engineer</h4>

                        <p class="job-company">
                            TechNova Solutions
                        </p>

                        <small>
                            📍 Remote &nbsp; • &nbsp; Full Time
                        </small>

                    </div>

                    <a
                        href="/jobs/software-engineer"
                        class="apply-btn"
                    >
                        View Job
                    </a>

                </div>


                <!-- Job 2 -->
                <div class="job-list-card mb-3">

                    <div>

                        <h4>Frontend Developer</h4>

                        <p class="job-company">
                            PixelCraft Labs
                        </p>

                        <small>
                            📍 Bangalore &nbsp; • &nbsp; Full Time
                        </small>

                    </div>

                    <a
                        href="/jobs/frontend-developer"
                        class="apply-btn"
                    >
                        View Job
                    </a>

                </div>


                <!-- Job 3 -->
                <div class="job-list-card mb-3">

                    <div>

                        <h4>UI/UX Designer</h4>

                        <p class="job-company">
                            Designify
                        </p>

                        <small>
                            📍 Hyderabad &nbsp; • &nbsp; Full Time
                        </small>

                    </div>

                    <a
                        href="/jobs/ui-ux-designer"
                        class="apply-btn"
                    >
                        View Job
                    </a>

                </div>


                <!-- Job 4 -->
                <div class="job-list-card mb-3">

                    <div>

                        <h4>Backend Developer</h4>

                        <p class="job-company">
                            DataCrunch
                        </p>

                        <small>
                            📍 Remote &nbsp; • &nbsp; Full Time
                        </small>

                    </div>

                    <a
                        href="/jobs/backend-developer"
                        class="apply-btn"
                    >
                        View Job
                    </a>

                </div>

            </div>

        </div>

    </main>


    <!-- Footer -->
    <%- include("partials/footer") %>


    <!-- Bootstrap JavaScript -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>