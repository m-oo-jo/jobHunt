<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Recruiter Dashboard - JobHunt</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/header") %>

    <main id="app-content" class="container py-5">

        <div class="job-card">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h1>Recruiter Dashboard</h1>
                    <p>Manage your job postings and applications.</p>
                </div>

                <a href="/recruiter/post" class="apply-btn">
                    + Post Job
                </a>

            </div>

            <div class="row g-3 mb-5">

                <div class="col-md-4">
                    <div class="job-card">
                        <h2 id="jobsCount">0</h2>
                        <p>Jobs Posted</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="job-card">
                        <h2 id="applicantsCount">0</h2>
                        <p>Applicants</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="job-card">
                        <h2 id="activeJobsCount">0</h2>
                        <p>Active Jobs</p>
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h2>Your Job Postings</h2>
                    <p>Manage the jobs you have posted.</p>
                </div>

                <a href="/recruiter/post" class="apply-btn">
                    + Post Job
                </a>

            </div>

            <div id="recruiterJobs">

                <p>Loading jobs...</p>

            </div>

        </div>

    </main>

    <%- include("partials/footer") %>

    <script src="/js/recruiter.js"></script>

</body>

</html>