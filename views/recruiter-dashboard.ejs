<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Recruiter Dashboard - JobHunt</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <%- include("partials/recruiter-header") %>

    <main id="app-content" class="container py-5">

        <!-- Dashboard Header -->
        <div class="job-card mb-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h1 class="mb-2">Recruiter Dashboard</h1>

                    <p class="mb-0">
                        Manage your job postings and applications.
                    </p>
                </div>

                <a
                    href="/recruiter/post"
                    class="apply-btn"
                >
                    + Post Job
                </a>

            </div>

        </div>


        <!-- Dashboard Statistics -->
        <div class="row g-4 mb-5">

            <div class="col-md-4">

                <div class="job-card h-100">

                    <h2
                        id="jobsCount"
                        class="mb-2"
                    >
                        0
                    </h2>

                    <p class="mb-0">
                        Jobs Posted
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="job-card h-100">

                    <h2
                        id="applicantsCount"
                        class="mb-2"
                    >
                        0
                    </h2>

                    <p class="mb-0">
                        Applicants
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="job-card h-100">

                    <h2
                        id="activeJobsCount"
                        class="mb-2"
                    >
                        0
                    </h2>

                    <p class="mb-0">
                        Active Jobs
                    </p>

                </div>

            </div>

        </div>


        <!-- Job Postings -->
        <div class="job-card">

            <div class="mb-4">

                <h2 class="mb-2">
                    Your Job Postings
                </h2>

                <p class="mb-0">
                    View and manage the jobs you have posted.
                </p>

            </div>


            <div id="recruiterJobs">

                <p>Loading jobs...</p>

            </div>

        </div>

    </main>


    <%- include("partials/footer") %>

    <script src="/js/recruiter.js"></script>

</body>

</html>